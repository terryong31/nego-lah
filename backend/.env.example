SUPABASE_URL=https://your-project.supabase.co
ADMIN_SUPABASE_KEY=your_service_role_secret_key
USER_SUPABASE_KEY=your_anon_public_key
GEMINI_API_KEY=your_google_gemini_api_key
STRIPE_API_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
REDIS_URL=redis://localhost:6379
DATABASE_URL=postgresql://postgres:<yourpostgrespassword>@db.<yoursupabaseurl>.supabase.co:5432/postgres
FRONTEND_URL=https://negolah.my
# Public origin of this API. Derived from FRONTEND_URL when unset; set it
# explicitly for a staging or forked domain. It is what Supabase auth links and
# the OAuth round trip redirect back to (SPEC-093), so it must also appear in
# `additional_redirect_urls` in supabase/config.toml.
#API_BASE_URL=https://api.negolah.my

# ===== Buyer session (SPEC-093) =====
# The buyer's Supabase tokens live in Redis behind this opaque, httpOnly cookie;
# the browser never holds a token. Same model as the admin cookie below, under
# its own names so one browser can hold both sessions.
USER_COOKIE_NAME=nl_sid
# Set to false ONLY for local http development; must be true in production.
USER_COOKIE_SECURE=true
# Must stay "lax": the Stripe return and every Supabase email link are top-level
# cross-site navigations, and "strict" withholds the cookie on exactly those.
USER_COOKIE_SAMESITE=lax
# 30 days, sliding. The local sidecar evicts shortest-TTL-first, so a long TTL
# keeps sessions out of the firing line; prod's managed Redis rejects writes at
# the cap rather than evicting anything. See ADR-0028.
USER_SESSION_TTL=2592000
# The buyer's readable CSRF cookie (JS must echo it back as X-CSRF-Token), and
# the short-lived holder for the OAuth PKCE verifier.
USER_CSRF_COOKIE_NAME=nl_csrf
USER_PKCE_COOKIE_NAME=nl_pkce
USER_PKCE_TTL=600

# ===== Admin =====
# Opaque admin session cookie.
ADMIN_COOKIE_NAME=admin_sid
# Set to false ONLY for local http development; must be true in production (https).
ADMIN_COOKIE_SECURE=true
# Admin session sliding TTL (seconds) and the 2FA pre-auth handle TTL (seconds).
ADMIN_SESSION_TTL=7200
ADMIN_PREAUTH_TTL=300

# ===== CSRF (admin console) =====
# Double-submit cookie for admin CSRF protection. The cookie is NOT httpOnly
# (JS must read it). Override secure/samesite for local http development.
CSRF_COOKIE_NAME=csrf_token
# Set to false ONLY for local http development; must be true in production.
CSRF_COOKIE_SECURE=true
# Use "lax" for local dev (cross-port); "strict" in production.
CSRF_COOKIE_SAMESITE=strict

# ===== Hybrid LLM routing (SPEC-020) =====
# Dispatches each chat turn between the self-hosted Apple Silicon MLX server
# (the ../local-llm project) and Google Gemini.
#   auto   - use the local model when its tunnel is healthy AND its single
#            generation slot is free; overflow to Gemini otherwise (default)
#   local  - prefer local, still falls back to Gemini if unreachable
#   gemini - never touch the local model (also what the test suite pins)
LLM_PROVIDER=auto
# OpenAI-compatible base URL of the local-llm server. In production this is the
# Cloudflare Tunnel; locally it's the MLX server. NOTE: local-llm defaults to
# port 8000, which collides with this backend — start it with `--port 8001`.
LOCAL_LLM_BASE_URL=https://llm.negolah.my/v1
LOCAL_LLM_MODEL=mlx-community/Qwen3.6-35B-A3B-4bit
# local-llm does not authenticate; any non-empty value satisfies the OpenAI client.
LOCAL_LLM_API_KEY=dummy-local-key
# Seconds to wait for tokens once connected. Generous on purpose: prefill on a
# 35B model with a long persona prompt and item images legitimately takes a while.
# (The connect timeout is a fixed 2s so a downed tunnel fails over instantly.)
LOCAL_LLM_READ_TIMEOUT=120
GEMINI_MODEL=gemini-3.8-flash

# ===== Local email via Mailpit (SPEC-074) =====
# When SMTP_HOST is set, every outbound email goes to this SMTP sink instead of
# the Resend API — nothing leaves the machine. Start the sink with
# `mise run dev:mailpit`, then read whatever the backend sent in the web UI at
# http://localhost:8025. Leave SMTP_HOST UNSET in production: prod must keep
# using Resend (the key comes from Infisical there).
SMTP_HOST=localhost
SMTP_PORT=1025
# Optional sender display address. Falls back to RESEND_FORWARD_FROM, then
# "Nego-Lah <noreply@negolah.my>".
#SMTP_FROM=Nego-Lah Dev <dev@negolah.my>

# ===== Observability (LangSmith) =====
# Disable in local development to conserve monthly quota; enable in production.
LANGSMITH_TRACING=false
#LANGSMITH_API_KEY=your_langsmith_api_key
#LANGSMITH_PROJECT=nego-lah

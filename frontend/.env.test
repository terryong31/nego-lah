# Dummy, non-secret values used only when running the test suite.
# @nuxt/test-utils' "nuxt" environment loads THIS file instead of `.env` when
# booting the test Nuxt instance, so real dev/prod Supabase credentials never
# get pulled into a test run. Do not put real secrets in this file.
SUPABASE_URL=https://test-project.supabase.co
SUPABASE_KEY=test-anon-key
API_BASE_URL=http://localhost:8000

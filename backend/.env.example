SUPABASE_URL=https://your-project.supabase.co
ADMIN_SUPABASE_KEY=your_service_role_secret_key
USER_SUPABASE_KEY=your_anon_public_key
GEMINI_API_KEY=your_google_gemini_api_key
STRIPE_API_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
REDIS_URL=redis://localhost:6379
DATABASE_URL=postgresql://postgres:<yourpostgrespassword>@db.<yoursupabaseurl>.supabase.co:5432/postgres
FRONTEND_URL=https://negolah.my

# ===== Admin =====
# Opaque admin session cookie.
ADMIN_COOKIE_NAME=admin_sid
# Set to false ONLY for local http development; must be true in production (https).
ADMIN_COOKIE_SECURE=true
# Admin session sliding TTL (seconds) and the 2FA pre-auth handle TTL (seconds).
ADMIN_SESSION_TTL=7200
ADMIN_PREAUTH_TTL=300

# ===== CSRF (admin console) =====
# Double-submit cookie for admin CSRF protection. The cookie is NOT httpOnly
# (JS must read it). Override secure/samesite for local http development.
CSRF_COOKIE_NAME=csrf_token
# Set to false ONLY for local http development; must be true in production.
CSRF_COOKIE_SECURE=true
# Use "lax" for local dev (cross-port); "strict" in production.
CSRF_COOKIE_SAMESITE=strict

# ===== Hybrid LLM routing (SPEC-020) =====
# Dispatches each chat turn between the self-hosted Apple Silicon MLX server
# (the ../local-llm project) and Google Gemini.
#   auto   - use the local model when its tunnel is healthy AND its single
#            generation slot is free; overflow to Gemini otherwise (default)
#   local  - prefer local, still falls back to Gemini if unreachable
#   gemini - never touch the local model (also what the test suite pins)
LLM_PROVIDER=auto
# OpenAI-compatible base URL of the local-llm server. In production this is the
# Cloudflare Tunnel; locally it's the MLX server. NOTE: local-llm defaults to
# port 8000, which collides with this backend — start it with `--port 8001`.
LOCAL_LLM_BASE_URL=https://llm.negolah.my/v1
LOCAL_LLM_MODEL=mlx-community/Qwen3.6-35B-A3B-4bit
# local-llm does not authenticate; any non-empty value satisfies the OpenAI client.
LOCAL_LLM_API_KEY=dummy-local-key
# Seconds to wait for tokens once connected. Generous on purpose: prefill on a
# 35B model with a long persona prompt and item images legitimately takes a while.
# (The connect timeout is a fixed 2s so a downed tunnel fails over instantly.)
LOCAL_LLM_READ_TIMEOUT=120
GEMINI_MODEL=gemini-3.8-flash

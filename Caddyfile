{
    email terryong30@gmail.com

    # SPEC-104: the client IP is read from CF-Connecting-IP only when the peer is
    # a Cloudflare edge. Any other peer's copy of that header is ignored, and the
    # reverse_proxy below overwrites it, so a caller cannot pick its own
    # rate-limit key. Ranges: https://www.cloudflare.com/ips/
    servers {
        trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
        client_ip_headers CF-Connecting-IP
    }
}

api.negolah.my {
    header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

    # ADR-0032: Cloudflare's IP ranges are shared by every tenant, so the firewall
    # alone cannot tell our zone from someone else's. Our zone's Transform Rule
    # sets X-Origin-Auth; without it the request never reaches the API. Inert
    # while ORIGIN_AUTH_SECRET is unset (see SPEC-104 for the rollout).
    @not_via_our_zone expression `{env.ORIGIN_AUTH_SECRET} != "" && {http.request.header.X-Origin-Auth} != {env.ORIGIN_AUTH_SECRET}`
    # The mark tells the deploy guard this 403 is ours, not one Cloudflare
    # answered itself (Bot Fight Mode, WAF) without reaching the origin, and
    # whether the zone's header was absent or wrong. Never echo the value: on a
    # mismatch it may be the zone's real secret.
    map {http.request.header.X-Origin-Auth} {origin_auth_header} {
        ""      absent
        default mismatched
    }
    header @not_via_our_zone X-Origin-Check "refused; X-Origin-Auth {origin_auth_header}"
    respond @not_via_our_zone "Forbidden" 403

    request_body {
        max_size 10MB
    }

    reverse_proxy backend:8000 {
        header_up CF-Connecting-IP {client_ip}
        header_up -X-Origin-Auth
    }
}

# Virtualenv & Python caches (rebuilt inside the image)
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Test artifacts & coverage reports
tests/
htmlcov/
.coverage
coverage.xml

# Secrets — injected at runtime via compose env_file, never baked into the image
.env
*.env
!.env.example

# Local data & databases
data/
dump.rdb
*.log
.DS_Store

# Version control & documentation
.git/
.gitignore
docs/
*.md
